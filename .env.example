# Copy this file to .env and add only the credentials you use.
# Never commit or share the real .env file.

# Google OAuth Desktop client credentials for private .gdoc lyric files.
# Run `video-lyrics google-auth` after setting the client ID and secret.
GOOGLE_DRIVE_CLIENT_ID=
GOOGLE_DRIVE_CLIENT_SECRET=
GOOGLE_DRIVE_REFRESH_TOKEN=

# Optional: only needed for the separately billed `--provider openai` backend.
OPENAI_API_KEY=
