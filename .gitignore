.env
.env.*
!.env.example
.venv/
__pycache__/
*.py[cod]
.pytest_cache/
.ruff_cache/
build/
dist/
*.egg-info/

# The pointer at the repo root is per-machine (absolute paths) - each clone makes
# its own with `video-lyrics init`. The per-song data files under work/ are kept,
# see below, so anchor these to the root only.
/project.json
/project.yaml
/project.yml

# Finished videos - hundreds of MB each, and rebuildable from what is kept below.
output/

# Working files are intermediates and stay out of git, with three exceptions per
# song: the project data (settings, cue timings, the scene plan), the timed
# lyrics, and the generated images. Those are the results worth keeping;
# everything else under work/ - transcripts, motion clips, overlay PNGs - is
# rebuilt from them.
#
# The images are listed by suffix rather than as `images/**`, so that only actual
# pictures are picked up: the manual provider's prompts.txt, and any half-written
# download an interrupted run left behind, are scratch and stay out.
work/**
!work/*/
!work/*/project.yaml
!work/*/lyrics.srt
!work/*/images/
!work/*/images/*.png
!work/*/images/*.webp
!work/*/images/*.jpg
!work/*/images/*.jpeg

.DS_Store
